                                <span className="w-2 h-2 rounded-full bg-blue-500"></span>
                                <span>PostgreSQL (生产环境)</span>
                              </div>
                            </div>
                          </div>
                          <div>
                            <h4 className="font-semibold text-slate-300 mb-2">数据模型：</h4>
                            <ul className="text-sm text-slate-400 space-y-1">
                              <li>• Task 表 - 任务存储</li>
                              <li>• Memory 表 - 记忆存储</li>
                              <li>• KnowledgeGraph 表 - 知识图谱</li>
                            </ul>
                          </div>
                        </div>
                      </div>

                      <div className="p-6 rounded-xl bg-slate-900/50 border border-slate-700/50">
                        <h3 className="text-lg font-bold text-red-400 mb-4">Redis 缓存层</h3>
                        <p className="text-slate-400 mb-4">
                          使用Redis作为缓存层，提供高性能的热点数据访问和会话管理。
                        </p>
                        <div className="grid md:grid-cols-2 gap-4">
                          <div>
                            <h4 className="font-semibold text-slate-300 mb-2">缓存策略：</h4>
                            <ul className="text-sm text-slate-400 space-y-1">
                              <li>• LRU 淘汰策略</li>
                              <li>• TTL 过期时间</li>
                              <li>• 读写穿透</li>
                            </ul>
                          </div>
                          <div>
                            <h4 className="font-semibold text-slate-300 mb-2">使用场景：</h4>
                            <ul className="text-sm text-slate-400 space-y-1">
                              <li>• 任务状态缓存</li>
                              <li>• 会话数据</li>
                              <li>• 频率限制</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
              )}

              {/* Deployment Section */}
              {activeSection === 'deployment' && (
                <div className="space-y-6">
                  <section className="bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-8">
                    <h2 className="text-2xl font-bold text-white mb-6">部署指南</h2>
                    
                    <div className="space-y-6">
                      <div>
                        <h3 className="text-xl font-semibold text-white mb-4">快速开始</h3>
                        <div className="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50">
                          <pre className="text-sm">
                            <code className="text-emerald-400">
{`# 克隆项目
git clone https://github.com/your-repo/enterprise-agent-system.git
cd enterprise-agent-system

# 安装依赖
pip install -r requirements.txt

# 启动API服务器
python start_api.py

# 启动可视化平台
cd visualization-platform
npm install
npm run dev`}
                            </code>
                          </pre>
                        </div>
                      </div>

                      <div className="grid md:grid-cols-2 gap-6">
                        <div className="p-6 rounded-xl bg-slate-900/50 border border-slate-700/50">
                          <h3 className="text-lg font-bold text-blue-400 mb-4">环境变量</h3>
                          <div className="space-y-3 text-sm">
                            <div>
                              <code className="text-cyan-400">DATABASE_URL</code>
                              <p className="text-slate-400">数据库连接字符串</p>
                            </div>
                            <div>
                              <code className="text-cyan-400">REDIS_URL</code>
                              <p className="text-slate-400">Redis连接地址</p>
                            </div>
                            <div>
                              <code className="text-cyan-400">API_HOST</code>
                              <p className="text-slate-400">API监听地址 (0.0.0.0)</p>
                            </div>
                            <div>
                              <code className="text-cyan-400">API_PORT</code>
                              <p className="text-slate-400">API监听端口 (8000)</p>
                            </div>
                          </div>
                        </div>

                        <div className="p-6 rounded-xl bg-slate-900/50 border border-slate-700/50">
                          <h3 className="text-lg font-bold text-purple-400 mb-4">Docker 部署</h3>
                          <pre className="text-sm bg-slate-950 rounded-lg p-4">
                            <code className="text-purple-400">
{`# 构建和启动
docker-compose up -d

# 查看日志
docker-compose logs -f

# 停止服务
docker-compose down`}
                            </code>
                          </pre>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
              )}
            </div>
          </main>
        </div>
      </div>
    </div>
  )
}
