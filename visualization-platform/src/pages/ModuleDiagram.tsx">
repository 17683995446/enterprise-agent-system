                </div>

                {/* 文件路径 */}
                {selectedData.filePath && (
                  <div>
                    <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center space-x-2">
                      <Code className="w-4 h-4 text-purple-400" />
                      <span>源码文件</span>
                    </h3>
                    <p className="font-mono text-xs text-emerald-400 bg-slate-800/50 border border-slate-700/50 rounded-lg p-3 break-all">
                      {selectedData.filePath}
                    </p>
                  </div>
                )}

                {/* 特性或类型 */}
                {selectedData.features && (
                  <div>
                    <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center space-x-2">
                      <Zap className="w-4 h-4 text-yellow-400" />
                      <span>核心特性</span>
                    </h3>
                    <div className="grid grid-cols-2 gap-2">
                      {selectedData.features.map((f: string, i: number) => (
                        <div key={i} className="px-3 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-sm text-slate-300">
                          {f}
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 数据类型 */}
                {selectedData.keyTypes && (
                  <div>
                    <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center space-x-2">
                      <Database className="w-4 h-4 text-emerald-400" />
                      <span>核心类型</span>
                    </h3>
                    <div className="flex flex-wrap gap-2">
                      {selectedData.keyTypes.map((t: string, i: number) => (
                        <span
                          key={i}
                          className="px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400"
                        >
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {/* 查看代码按钮 */}
                {selectedData.filePath && (
                  <div className="pt-4 border-t border-slate-700/50">
                    <button
                      className="flex items-center justify-center space-x-2 w-full px-4 py-3 rounded-lg bg-gradient-to-r from-purple-500 to-pink-600 text-white font-medium hover:shadow-lg transition-all"
                    >
                      <Code className="w-4 h-4" />
                      <span>查看源代码</span>
                    </button>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Footer info */}
      <div className="bg-slate-900/80 backdrop-blur-xl border-t border-slate-700/50 px-6 py-3">
        <div className="flex items-center justify-between text-sm">
          <div className="flex items-center space-x-6">
            <span className="text-slate-400">
              <span className="text-emerald-400 font-medium">{nodes.length}</span> 模块 | 
              <span className="text-blue-400 font-medium ml-1">{edges.length}</span> 关系
            </span>
            <span className="text-slate-500">点击模块查看详情</span>
          </div>
          <div className="text-slate-500">
            Enterprise Agent System • Module Diagram
          </div>
        </div>
      </div>
    </div>
  )
}
