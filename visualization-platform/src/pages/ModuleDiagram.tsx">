export default function ModuleDiagramPage() {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes)
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges)
  const [selectedNode, setSelectedNode] = useState<string | null>(null)
  const [showDetails, setShowDetails] = useState(false)
  const [activeTab, setActiveTab] = useState<'overview' | 'dependencies' | 'code'>('overview')

  const onConnect = useCallback(
    (params: Connection) => setEdges((eds) => addEdge(params, eds)),
    [setEdges]
  )

  const onNodeClick = useCallback((event: React.MouseEvent, node: Node) => {
    setSelectedNode(node.id)
    setShowDetails(true)
  }, [])

  const selectedData = selectedNode ? moduleDetails[selectedNode as keyof typeof moduleDetails] : null

  const getNodeColor = (nodeId: string) => {
    if (nodeId.startsWith('domain') || nodeId.startsWith('task') || nodeId.startsWith('memory') || nodeId.startsWith('knowledge') || nodeId.startsWith('experience')) return 'emerald'
    if (nodeId.startsWith('core') || nodeId.startsWith('agent') || nodeId.startsWith('storage') || nodeId.startsWith('factory')) return 'blue'
    if (nodeId.startsWith('infra') || nodeId.startsWith('logging') || nodeId.startsWith('config') || nodeId.startsWith('fastapi') || nodeId.startsWith('github') || nodeId.startsWith('redis') || nodeId.startsWith('sqlalchemy')) return 'purple'
    if (nodeId.startsWith('app') || nodeId.startsWith('cli') || nodeId.startsWith('vue') || nodeId.startsWith('reactivity')) return 'cyan'
    if (nodeId.startsWith('presentation') || nodeId.startsWith('react') || nodeId.startsWith('vite')) return 'cyan'
    return 'slate'
  }

  const nodeColor = selectedNode ? getNodeColor(selectedNode) : 'slate'

  return (
    <div className="h-screen flex flex-col">
      {/* Header */}
      <div className="bg-slate-900/80 backdrop-blur-xl border-b border-slate-700/50 px-6 py-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center space-x-4">
            <div className="p-3 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600">
              <Package className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-white">模块关系图</h1>
              <p className="text-sm text-slate-400">详细展示各模块的依赖关系和功能</p>
            </div>
          </div>
          <div className="flex items-center space-x-3">
            <select
              className="px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700 text-slate-300 text-sm"
              value={activeTab}
              onChange={(e) => setActiveTab(e.target.value as any)}
            >
              <option value="overview">概览模式</option>
              <option value="dependencies">依赖分析</option>
              <option value="code">代码视图</option>
            </select>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="flex-1 flex">
        {/* Graph Area */}
        <div className={`flex-1 relative ${showDetails ? 'w-2/3' : 'w-full'}`}>
          <ReactFlow
            nodes={nodes}
            edges={edges}
            onNodesChange={onNodesChange}
            onEdgesChange={onEdgesChange}
            onConnect={onConnect}
            onNodeClick={onNodeClick}
            fitView
            attributionPosition="bottom-left"
            className="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
          >
            <Controls className="bg-slate-800 border border-slate-700 rounded-lg shadow-xl" />
            <Background color="#475569" gap={20} className="opacity-20" />
            
            <Panel position="top-left" className="bg-slate-800/90 backdrop-blur-xl border border-slate-700 rounded-lg p-4 shadow-xl">
              <h3 className="text-sm font-bold text-white mb-2">模块图例</h3>
              <div className="text-xs text-slate-400 space-y-2">
                <div className="flex items-center space-x-2">
                  <div className="w-3 h-3 rounded-full bg-emerald-500" />
                  <span>Domain Layer</span>
                </div>
                <div className="flex items-center space-x-2">
                  <div className="w-3 h-3 rounded-full bg-blue-500" />
                  <span>Core Layer</span>
                </div>
                <div className="flex items-center space-x-2">
                  <div className="w-3 h-3 rounded-full bg-purple-500" />
                  <span>Infrastructure</span>
                </div>
                <div className="flex items-center space-x-2">
                  <div className="w-3 h-3 rounded-full bg-cyan-500" />
                  <span>Application</span>
                </div>
              </div>
            </Panel>
          </ReactFlow>
        </div>

        {/* Details Panel */}
        {showDetails && selectedData && (
          <div className="w-1/3 bg-slate-900/95 backdrop-blur-xl border-l border-slate-700/50 overflow-y-auto">
